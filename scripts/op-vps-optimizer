#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="/opt/op-vps-optimizer/scripts"

usage() {
    cat <<'EOF'
OP VPS Optimizer - Streaming Edition

Usage:
  op-vps-optimizer [command] [options]

Commands:
  apply              Apply streaming network optimization
  status             Show settings and streaming health check
  profile auto       OP SmartFlow: switch H+ / LTE profiles
                     automatically (recommended)
  profile lte        Force the LTE profile
  profile hplus      Force the H+ / lossy-link profile
  profile status     Show SmartFlow mode and retransmit rate
  profile off        Disable SmartFlow
  stability apply    Longer UDP timeouts and keepalives
  stability quic-block
                     Block QUIC (UDP 443) so apps use TCP (optional)
  stability quic-allow
                     Allow QUIC again
  stability status   Show stability state
  stability off      Remove stability changes and restore values
  doctor             Find what limits streaming speed
                     (run while a phone is streaming)
  doctor fix         Raise UDP tunnel buffers
  doctor unfix       Restore UDP buffer defaults
  rollback           Restore original kernel settings and remove
                     the optimizer service and firewall clamp
  rollback --full    Same as rollback, and also remove the
                     OP BadVPN-UDPGW services
  install-badvpn     Install or update BadVPN-UDPGW (ports 7100,
                     7200, 7300 on 127.0.0.1)
  help               Display this help message
EOF
}

run_script() {
    local script="$SCRIPT_DIR/$1"
    shift
    if [[ ! -x "$script" ]]; then
        echo "Error: missing or not executable: $script"
        echo "Re-run the installer one-liner to repair the installation."
        exit 1
    fi
    exec "$script" "$@"
}

COMMAND="${1:-apply}"
[[ $# -gt 0 ]] && shift

case "$COMMAND" in
    apply)          run_script optimize.sh "$@" ;;
    status)         run_script status.sh "$@" ;;
    profile)        run_script stream-profile.sh "$@" ;;
    stability)      run_script stability.sh "$@" ;;
    doctor)         run_script doctor.sh "$@" ;;
    rollback)       run_script rollback.sh "$@" ;;
    install-badvpn) run_script install-badvpn.sh "$@" ;;
    help|-h|--help) usage ;;
    *)
        echo "Unknown command: $COMMAND"
        echo
        usage
        exit 2
        ;;
esac
